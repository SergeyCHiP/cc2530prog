#
# Makefile for libgpiod GPIO testing
# Modern GPIO library with excellent Raspberry Pi 5 support
#

CC?=gcc
CFLAGS?=-Wall -Wextra
DEBUG?=0

# Debug flags
ifeq ($(DEBUG),1)
    CFLAGS += -DDEBUG=1 -g -O0
else
    CFLAGS += -O2
endif

# libgpiod library
LIBS += -lgpiod

# Targets
all: test-libgpiod

test-libgpiod: test_gpio_libgpiod.c
	$(CC) $(CFLAGS) -o test-libgpiod $< $(LIBS)
	@echo "✅ Built test-libgpiod with libgpiod backend"

# Debug version
debug: CFLAGS += -DDEBUG=1 -g -O0
debug: test-libgpiod

# Run test (requires sudo for GPIO access)
run: test-libgpiod
	sudo ./test-libgpiod

# Check libgpiod installation
check-libgpiod:
	@echo "Checking libgpiod installation..."
	@echo "Version: $(shell pkg-config --modversion libgpiod 2>/dev/null || echo 'Not found')"
	@echo "Libraries: $(shell pkg-config --libs libgpiod 2>/dev/null || echo 'Not found')"
	@echo "CFLAGS: $(shell pkg-config --cflags libgpiod 2>/dev/null || echo 'Not found')"
	@echo ""
	@echo "To install libgpiod:"
	@echo "  sudo apt install libgpiod-dev"

# Install libgpiod
install-libgpiod:
	@echo "Installing libgpiod..."
	sudo apt update
	sudo apt install libgpiod-dev
	@echo "✅ libgpiod installed"

# Clean
clean:
	rm -f test-libgpiod

# Help
help:
	@echo "Available targets:"
	@echo "  all              - Build test program (default)"
	@echo "  test-libgpiod    - Build test program"
	@echo "  debug            - Build with debug symbols"
	@echo "  run              - Build and run test"
	@echo "  check-libgpiod   - Check libgpiod installation"
	@echo "  install-libgpiod - Install libgpiod"
	@echo "  clean            - Remove build artifacts"
	@echo "  help             - Show this help"
	@echo ""
	@echo "Variables:"
	@echo "  DEBUG            - Enable debug (0/1)"
	@echo "  CC               - C compiler"
	@echo "  CFLAGS           - C compiler flags"
	@echo ""
	@echo "Examples:"
	@echo "  make"
	@echo "  make DEBUG=1"
	@echo "  make check-libgpiod"
	@echo "  make install-libgpiod"
	@echo "  make run"
	@echo ""
	@echo "Note: libgpiod is the modern GPIO library with excellent"
	@echo "      Raspberry Pi 5 support."

.PHONY: all test-libgpiod debug run check-libgpiod install-libgpiod clean help 