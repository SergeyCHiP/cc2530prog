#
# Makefile for fixed pigpio GPIO testing
# Works with Raspberry Pi 5 and other models
#

CC?=gcc
CFLAGS?=-Wall -Wextra
DEBUG?=0

# Debug flags
ifeq ($(DEBUG),1)
    CFLAGS += -DDEBUG=1 -g -O0
else
    CFLAGS += -O2
endif

# pigpio library
LIBS += -lpigpio

# Targets
all: test-pigpio-fixed

test-pigpio-fixed: test_gpio_pigpio_fixed.c
	$(CC) $(CFLAGS) -o test-pigpio-fixed $< $(LIBS)
	@echo "✅ Built test-pigpio-fixed with fixed pigpio backend"

# Debug version
debug: CFLAGS += -DDEBUG=1 -g -O0
debug: test-pigpio-fixed

# Run test (requires sudo for GPIO access)
run: test-pigpio-fixed
	sudo ./test-pigpio-fixed

# Check pigpiod daemon
check-daemon:
	@echo "Checking pigpiod daemon status..."
	sudo systemctl status pigpiod || echo "pigpiod not running"
	@echo ""
	@echo "To start pigpiod:"
	@echo "  sudo systemctl start pigpiod"
	@echo "  sudo systemctl enable pigpiod"

# Start pigpiod daemon
start-daemon:
	@echo "Starting pigpiod daemon..."
	sudo systemctl start pigpiod
	sudo systemctl enable pigpiod
	@echo "✅ pigpiod daemon started"

# Clean
clean:
	rm -f test-pigpio-fixed

# Help
help:
	@echo "Available targets:"
	@echo "  all              - Build test program (default)"
	@echo "  test-pigpio-fixed - Build test program"
	@echo "  debug            - Build with debug symbols"
	@echo "  run              - Build and run test"
	@echo "  check-daemon     - Check pigpiod daemon status"
	@echo "  start-daemon     - Start pigpiod daemon"
	@echo "  clean            - Remove build artifacts"
	@echo "  help             - Show this help"
	@echo ""
	@echo "Variables:"
	@echo "  DEBUG            - Enable debug (0/1)"
	@echo "  CC               - C compiler"
	@echo "  CFLAGS           - C compiler flags"
	@echo ""
	@echo "Examples:"
	@echo "  make"
	@echo "  make DEBUG=1"
	@echo "  make check-daemon"
	@echo "  make start-daemon"
	@echo "  make run"

.PHONY: all test-pigpio-fixed debug run check-daemon start-daemon clean help 