#
# Makefile for Mock GPIO testing (macOS)
# No real GPIO hardware required
#

CC?=gcc
CFLAGS?=-Wall -Wextra
DEBUG?=0

# Debug flags
ifeq ($(DEBUG),1)
    CFLAGS += -DDEBUG=1 -g -O0
else
    CFLAGS += -O2
endif

# No external libraries needed for mock
LIBS=

# Targets
all: test-mock

test-mock: test_gpio_mock.c
	$(CC) $(CFLAGS) -o test-mock $< $(LIBS)
	@echo "✅ Built test-mock with mock GPIO backend"

# Debug version
debug: CFLAGS += -DDEBUG=1 -g -O0
debug: test-mock

# Run test (no sudo needed for mock)
run: test-mock
	./test-mock

# Clean
clean:
	rm -f test-mock

# Help
help:
	@echo "Available targets:"
	@echo "  all          - Build test program (default)"
	@echo "  test-mock    - Build test program"
	@echo "  debug        - Build with debug symbols"
	@echo "  run          - Build and run test"
	@echo "  clean        - Remove build artifacts"
	@echo "  help         - Show this help"
	@echo ""
	@echo "Variables:"
	@echo "  DEBUG        - Enable debug (0/1)"
	@echo "  CC           - C compiler"
	@echo "  CFLAGS       - C compiler flags"
	@echo ""
	@echo "Examples:"
	@echo "  make"
	@echo "  make DEBUG=1"
	@echo "  make run"
	@echo ""
	@echo "Note: This is a mock implementation for testing GPIO logic"
	@echo "      without real hardware. No sudo required."

.PHONY: all test-mock debug run clean help 