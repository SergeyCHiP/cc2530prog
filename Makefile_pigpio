#
# Makefile for pigpio GPIO testing
# Uses only the system pigpio library
#

CC?=gcc
CFLAGS?=-Wall -Wextra
DEBUG?=0

# Debug flags
ifeq ($(DEBUG),1)
    CFLAGS += -DDEBUG=1 -g -O0
else
    CFLAGS += -O2
endif

# pigpio library
LIBS += -lpigpio

# Targets
all: test-pigpio

test-pigpio: test_gpio_pigpio.c
	$(CC) $(CFLAGS) -o test-pigpio $< $(LIBS)
	@echo "✅ Built test-pigpio with pigpio backend"

# Debug version
debug: CFLAGS += -DDEBUG=1 -g -O0
debug: test-pigpio

# Run test (requires sudo for GPIO access)
run: test-pigpio
	sudo ./test-pigpio

# Clean
clean:
	rm -f test-pigpio

# Help
help:
	@echo "Available targets:"
	@echo "  all          - Build test program (default)"
	@echo "  test-pigpio  - Build test program"
	@echo "  debug        - Build with debug symbols"
	@echo "  run          - Build and run test"
	@echo "  clean        - Remove build artifacts"
	@echo "  help         - Show this help"
	@echo ""
	@echo "Variables:"
	@echo "  DEBUG        - Enable debug (0/1)"
	@echo "  CC           - C compiler"
	@echo "  CFLAGS       - C compiler flags"
	@echo ""
	@echo "Examples:"
	@echo "  make"
	@echo "  make DEBUG=1"
	@echo "  make run"

.PHONY: all test-pigpio debug run clean help 